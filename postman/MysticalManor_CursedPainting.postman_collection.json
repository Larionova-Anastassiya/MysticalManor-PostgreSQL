{
  "info": {
    "name": "Mystical Manor — The Cursed Painting API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in numeric order against local Docker backend. Player and attempt IDs are saved automatically."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "playerId",
      "value": "1"
    },
    {
      "key": "paintingId",
      "value": "1"
    },
    {
      "key": "attemptId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create Player",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/players",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "players"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Painter\",\n  \"characterClass\": \"Artist\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"playerId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
