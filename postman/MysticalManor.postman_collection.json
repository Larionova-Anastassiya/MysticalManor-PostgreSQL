{
  "info": {
    "name": "Mystical Manor — REST API CRUD",
    "description": "Run requests in order from 01 to 11. Create player automatically saves playerId as a collection variable. 10 deletes the test player.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create player",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/players",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "players"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Hero\",\n  \"characterClass\": \"Artist\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const p = pm.response.json();",
              "pm.collectionVariables.set(\"playerId\", String(p.id));",
              "pm.test(\"Player created\", () => pm.expect(p.name).to.eql(\"Postman Hero\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List players",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/players",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "players"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Get player by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/players/{{playerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "players",
            "{{playerId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Correct player ID\", () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"playerId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Update player",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/players/{{playerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "players",
            "{{playerId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Postman Hero\",\n  \"characterClass\": \"Explorer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Player updated\", () => pm.expect(pm.response.json().characterClass).to.eql(\"Explorer\"));"
            ]
          }
        }
      ]
    },
